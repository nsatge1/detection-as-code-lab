        "ParentImage": "C:\\Windows\\explorer.exe"
      }
    },
    {
      "description": "slash variant /e with pwsh",
      "event": {
        "EventID": 1,
        "Computer": "WIN-FIN-07",
        "User": "CORP\\j.doe",
        "Image": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
        "CommandLine": "pwsh.exe /e SQBFAFgA",
        "ParentImage": "C:\\Windows\\explorer.exe"
      }
    },
    {
      "description": "renamed binary caught by OriginalFileName",
      "event": {
        "EventID": 1,
        "Computer": "WIN-FIN-07",
        "User": "CORP\\j.doe",
        "Image": "C:\\Users\\Public\\update.exe",
        "CommandLine": "update.exe -ec SQBFAFgA",
        "ParentImage": "C:\\Windows\\explorer.exe",
        "OriginalFileName": "PowerShell.EXE"
      }
    }
  ],
  "should_not_match": [
