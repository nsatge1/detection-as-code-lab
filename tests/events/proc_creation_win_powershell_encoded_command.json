        "ParentImage": "C:\\Windows\\explorer.exe",
        "OriginalFileName": "PowerShell.EXE"
      }
    },
    {
      "description": "short -enc flag with hidden window",
      "event": {
        "EventID": 1,
        "Computer": "WIN-FIN-07",
        "User": "CORP\\j.doe",
        "Image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
