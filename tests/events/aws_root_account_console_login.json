{
  "should_match": [
    {
      "description": "root login success",
      "event": {
        "eventVersion": "1.09",
        "eventSource": "signin.amazonaws.com",
        "eventName": "ConsoleLogin",
        "sourceIPAddress": "203.0.113.50",
        "userIdentity": {
          "type": "Root",
          "arn": "arn:aws:iam::111122223333:root"
        },
        "responseElements": {
          "ConsoleLogin": "Success"
        }
      }
    }
  ],
  "should_not_match": [
    {
      "description": "root login failed",
      "event": {
        "eventVersion": "1.09",
        "eventSource": "signin.amazonaws.com",
        "eventName": "ConsoleLogin",
        "userIdentity": {
          "type": "Root"
        },
        "responseElements": {
          "ConsoleLogin": "Failure"
        }
      }
    },
    {
      "description": "IAM user login",
      "event": {
        "eventVersion": "1.09",
        "eventSource": "signin.amazonaws.com",
        "eventName": "ConsoleLogin",
        "userIdentity": {
          "type": "IAMUser",
          "userName": "nathan"
        },
        "responseElements": {
          "ConsoleLogin": "Success"
        }
      }
    }
  ]
}
